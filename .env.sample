# Slack Configuration Values
SLACK_OAUTH_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C...
# Set to true to stop posting/updating door-entry messages in Slack (lookups
# still work; the door poller and webhook keep running).
#SLACK_POSTING_DISABLED=true

# Unifi Door Endpoint Configuration
UNIFI_DOOR_API=https://192.168.1.1:12445
UNIFI_DOOR_TOKEN=Wh...
UNIFI_DOOR_DEVICES=5f9...

DOOR_ACCESS_WEBHOOK_ENDPOINT=https://api.example.com/door-access
DOOR_ACCESS_WEBHOOK_API_KEY=mA...

UNIFI_CLOUD_USERNAME=root
UNIFI_CLOUD_PASSWORD=KyE...

# Camera snapshot API server
CAMERA_API_PORT=8787
CAMERA_API_PATH=/api/camera-snapshots
CAMERA_API_KEY=replace-with-your-api-key
CAMERA_SNAPSHOT_TIMEOUT_MS=10000
CAMERA_SNAPSHOT_CONCURRENCY=4
CAMERA_SNAPSHOT_START_INTERVAL_MS=150

# UniFi Protect controllers. The first controller uses unsuffixed vars; add
# more consoles (e.g. a UDM alongside a UNVR) with _2, _3, ... suffixes.
# Each controller authenticates with its own API token if set, otherwise with
# username/password (falling back to the unsuffixed Protect credentials, then
# UNIFI_CLOUD_USERNAME/PASSWORD).
UNIFI_PROTECT_HOST=https://192.168.6.199
UNIFI_PROTECT_API_TOKEN=your_protect_integration_api_key
UNIFI_PROTECT_NAME=UNVR
UNIFI_PROTECT_HOST_2=https://192.168.1.1
UNIFI_PROTECT_NAME_2=UDM
#UNIFI_PROTECT_API_TOKEN_2=optional_api_key_for_second_controller

# Protect credentials (falls back to UNIFI_CLOUD_USERNAME/PASSWORD if not set)
UNIFI_PROTECT_USERNAME=root
UNIFI_PROTECT_PASSWORD=your_password

# Costco Same-Day automation (costco-automation.mjs). The /api/costco routes
# are mounted on the camera API server above, so they share its port (8787).
# Shared secret the foundations app sends as x-api-key. Falls back to
# CAMERA_API_KEY (the doorbot key) when unset.
COSTCO_AUTOMATION_API_KEY=
COSTCO_AUTOMATION_PORT=8789  # only used by the optional standalone `costco:serve`
COSTCO_PROFILE_DIR=          # default ~/.costco-automation-profile
COSTCO_HEADLESS=true
COSTCO_DEBUG_DIR=            # failure screenshots/HTML; default ~/costco-debug
COSTCO_TIMEOUT_MS=60000
# Optional: Slack channel to alert when the session needs a human re-login
#COSTCO_ALERT_SLACK_CHANNEL_ID=C...
# Not used by the automation (login is always human-driven), documented here
# for the on-call person bootstrapping the session:
#COSTCO_EMAIL=
#COSTCO_PASSWORD=
