{
  "name": "foundation-door-bot",
  "version": "1.0.0",
  "main": "main.mjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "doorbot": "node cli.mjs",
    "create": "node cli.mjs create",
    "activate": "node cli.mjs activate",
    "deactivate": "node cli.mjs deactivate",
    "status": "node cli.mjs status",
    "refresh-auth": "node refresh-auth.mjs",
    "add-foundations-group": "node add-foundations-group.mjs",
    "camera-api": "node camera-api-server.mjs",
    "camera-api:install": "bash install-camera-api.sh",
    "camera-api:uninstall": "launchctl unload ~/Library/LaunchAgents/com.foundations.camera-api.plist 2>/dev/null; rm -f ~/Library/LaunchAgents/com.foundations.camera-api.plist && echo 'Uninstalled com.foundations.camera-api'",
    "camera-api:logs": "tail -f camera-api.log camera-api.err.log"
  },
  "bin": {
    "doorbot": "./cli.mjs"
  },
